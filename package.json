{
  "name": "flashcards",
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "astro": "astro",
    "db:generate": "npm run db:generate:main && npm run db:generate:metrics",
    "db:generate:main": "drizzle-kit generate --config=drizzle.main.config.js",
    "db:generate:metrics": "drizzle-kit generate --config=drizzle.metrics.config.js",
    "db:migrate": "npm run db:migrate:main && npm run db:migrate:metrics",
    "db:migrate:main": "drizzle-kit migrate --config=drizzle.main.config.js",
    "db:migrate:metrics": "drizzle-kit migrate --config=drizzle.metrics.config.js",
    "db:studio:main": "drizzle-kit studio --config=drizzle.main.config.js",
    "db:studio:metrics": "drizzle-kit studio --config=drizzle.metrics.config.js"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "http-graceful-shutdown": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "web-vitals": "^6.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
